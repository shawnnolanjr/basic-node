<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Title</title>
    <link rel="stylesheet" href="/css/bootstrap.css" crossorigin="">
</head>
<body>
<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">Navbar</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link active" aria-current="page" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/items">Items</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                       aria-expanded="false">
                        Dropdown
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/users">Users</a></li>
                        <li><a class="dropdown-item" href="/dashboard">Dashboard</a></li>
                        <li><a class="dropdown-item" href="/logout">Logout</a></li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item" href="#">Separated link</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link disabled" aria-disabled="true">Disabled</a>
                </li>
            </ul>
            <form class="d-flex" role="search">
                <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
                <button class="btn btn-outline-success" type="submit">Search</button>
            </form>
        </div>
    </div>
</nav>

<div class="min-vh-100">
    {{{body}}}
</div>

<div class="d-flex justify-content-center sticky-bottom">
    <footer>
        <p>footer.</p>
    </footer>
</div>

<script src="/js/bootstrap.bundle.min.js"></script>
<script src="/javascripts/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8="
<script type="application/javascript">
    (function ($) {
        let $loginForm = $('form#loginForm'),
                $registerForm = $('form#registerForm'),
                $btn = $('.btn'),
                $errMsg = $('.error-msg');
        $btn.on('click', function (e) {
            e.preventDefault();
            if (this.id === 'loginBtn') {
                let postLogin = $.post('/api/v1/login', $loginForm.serialize());
                postLogin
                        .done(function (data) {
                            console.log('done', data);
                            window.location.href = data.redirect;
                        })
                        .fail(function (err) {
                            console.log('fail', err);
                            return err;
                        });
            }
            if (this.id === 'registerBtn') {
                let postLogin = $.post('/api/v1/register', $registerForm.serialize());
                postLogin
                        .done(function (data) {
                            console.log('done', data);
                            if (data.err) {
                                $errMsg
                                        .removeClass('none')
                                        .text(data.err);
                            } else {
                                $errMsg
                                        .addClass('none');
                            }
                            return data;
                        })
                        .fail(function (err) {
                            console.log('fail', err);
                            return err;
                        });
            }
        });
    })(jQuery);
</script>
</body>
</html>